[Unit]
Description=Smetika Landing Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/projects/ADV_CAMPAGN/landing_page/backend
Environment=HOME=/root
Environment=PATH=/usr/bin:/usr/local/bin
EnvironmentFile=/root/projects/ADV_CAMPAGN/landing_page/backend/.env
ExecStart=/usr/bin/node /root/projects/ADV_CAMPAGN/landing_page/backend/src/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
